// CozyVTT Database Schema

// The database address is not set here: the command-line tools read it from
// prisma.config.ts, and the app's client from DATABASE_URL in
// src/config/database.ts.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum PlatformRole {
  ADMIN
  USER
}

enum CampaignStatus {
  PREPARATION
  ACTIVE
  PAUSED
  INACTIVE
  COMPLETED
  ARCHIVED
}

enum CampaignRole {
  DM
  PLAYER
  SPECTATOR
}

enum AssetType {
  MAP
  TOKEN
  AUDIO
  AVATAR
  DOCUMENT
  OTHER
}

enum AssetScope {
  GLOBAL
  USER
  CAMPAIGN
}

enum MessageType {
  PLAYER
  DM
  SYSTEM
  DICE_ROLL
  CHARACTER_ACTION
  WHISPER
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum GameSystem {
  DND_5E
  PATHFINDER_2E
  SHADOWRUN_6E
  CALL_OF_CTHULHU_7E
}

enum RulebookStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum ChunkType {
  SPELL
  ITEM
  CLASS
  SUBCLASS
  FEAT
  MONSTER
  RACE
  BACKGROUND
  RULE
  TABLE
  NARRATIVE
}

enum LicenseType {
  SRD_5E
  SRD_5_1
  SRD_5_5
  COPYRIGHT_WOTC
  CC_BY_4
  DM_GUILD
  UNKNOWN
}

enum ChangeType {
  PLAYER_EDIT
  DM_SUGGESTION
  DM_OVERRIDE
  DM_LOCK
  DM_UNLOCK
  CONFLICT_RESOLVED
  SYSTEM_CORRECTION
}

enum ConflictType {
  INVALID_VALUE
  MISSING_PREREQUISITE
  EXCEEDS_LIMIT
  DUPLICATE
  INCOMPATIBLE_CHOICES
  RULE_VIOLATION
}

enum ConflictSeverity {
  INFO
  WARNING
  ERROR
  BLOCKING
}

enum TileCategory {
  FLOOR
  WALL
  CORNER
  DOOR
  FURNITURE
  PROP
  STAIRS
  SPECIAL
}

enum LayerType {
  TERRAIN
  STRUCTURE
  FURNITURE
  WALLS
  LIGHTING
  FOG
  TOKENS
  ANNOTATIONS
}

enum ActionType {
  ATTACK_MELEE
  ATTACK_RANGED
  SPELL_ATTACK
  SPELL_SAVE
  SPELL_AOE
  FEATURE
  ITEM_USE
  REACTION
  MOVEMENT
  OTHER
}

enum ActionCost {
  ACTION
  BONUS_ACTION
  REACTION
  FREE
  MOVEMENT
  LEGENDARY
  MYTHIC
}

enum ActionSource {
  CLASS
  SUBCLASS
  FEAT
  ITEM
  RACE
  BACKGROUND
  SPELL
  RACIAL
  CLASS_FEATURE
  MAGIC_ITEM
  OTHER
}

enum ResolutionStatus {
  PREVIEW
  ROLLING
  DM_REVIEW
  APPLIED
  CANCELLED
}

model MapTile {
  id          String       @id @default(uuid())
  campaignId  String
  campaign    Campaign     @relation("MapTiles", fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  category    TileCategory
  assetId     String // References Asset
  asset       Asset        @relation("MapTileAsset", fields: [assetId], references: [id], onDelete: Cascade)
  width       Int // In grid squares
  height      Int // In grid squares
  connections Json? // Wang tile connection rules: {north, south, east, west, autoTile}
  isDefault   Boolean      @default(false)
  createdById String?
  createdBy   User?        @relation("MapTileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([campaignId, category])
}

model MapLayer {
  id        String    @id @default(uuid())
  mapId     String
  map       Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  name      String
  type      LayerType
  order     Int
  visible   Boolean   @default(true)
  locked    Boolean   @default(false)
  data      Json // Layer-specific: tiles[], vectors[], annotations[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([mapId, name])
  @@index([mapId])
}

model CharacterDraft {
  id             String    @id @default(uuid())
  characterId    String    @unique
  character      Character @relation("CharacterDraft", fields: [characterId], references: [id], onDelete: Cascade)
  data           Json // Working copy of sheet data
  version        Int       @default(1)
  lastEditedById String
  lastEditedBy   User      @relation("CharacterDraftLastEditedBy", fields: [lastEditedById], references: [id])
  updatedAt      DateTime  @updatedAt
}

model CharacterChange {
  id           String     @id @default(uuid())
  characterId  String
  character    Character  @relation("CharacterChanges", fields: [characterId], references: [id], onDelete: Cascade)
  fieldPath    String // Dot notation: "stats.strength.score", "feats[2].name"
  oldValue     Json?
  newValue     Json?
  changeType   ChangeType
  authorId     String
  author       User       @relation("CharacterChangeAuthor", fields: [authorId], references: [id])
  resolvedById String?
  resolvedBy   User?      @relation("CharacterChangeResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  note         String?    @db.Text
  createdAt    DateTime   @default(now())

  @@index([characterId, createdAt])
  @@index([authorId])
}

model CharacterLock {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation("CharacterLocks", fields: [characterId], references: [id], onDelete: Cascade)
  fieldPath   String
  lockedById  String
  lockedBy    User      @relation("CharacterLockLockedBy", fields: [lockedById], references: [id])
  reason      String?   @db.Text
  createdAt   DateTime  @default(now())

  @@unique([characterId, fieldPath])
  @@index([characterId])
}

model CharacterConflict {
  id           String           @id @default(uuid())
  characterId  String
  character    Character        @relation("CharacterConflicts", fields: [characterId], references: [id], onDelete: Cascade)
  fieldPath    String
  conflictType ConflictType
  description  String
  severity     ConflictSeverity
  detectedAt   DateTime         @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?            @relation("CharacterConflictResolvedBy", fields: [resolvedById], references: [id])
  resolution   String?          @db.Text

  @@index([characterId, resolvedAt])
}

model Rulebook {
  id             String         @id @default(uuid())
  campaignId     String
  campaign       Campaign       @relation("Rulebooks", fields: [campaignId], references: [id], onDelete: Cascade)
  title          String
  sourceId       String
  edition        String
  filePath       String
  thumbnailPath  String?
  status         RulebookStatus @default(PENDING)
  totalPages     Int?
  processedPages Int            @default(0)
  uploadedById   String
  uploadedBy     User           @relation("RulebookUploadedBy", fields: [uploadedById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  chunks      RulebookChunk[]
  activations RulebookActivation[]

  @@index([campaignId])
  @@index([sourceId])
}

model RulebookChunk {
  id          String    @id @default(uuid())
  rulebookId  String
  rulebook    Rulebook  @relation(fields: [rulebookId], references: [id], onDelete: Cascade)
  pageStart   Int
  pageEnd     Int
  contentType ChunkType
  rawText     String    @db.Text
  structured  Json?
  confidence  Float     @default(0.0)
  embedding   Json? // pgvector stored as JSON array
  createdAt   DateTime  @default(now())

  @@index([rulebookId])
  @@index([contentType])
}

model RulebookActivation {
  id            String     @id @default(uuid())
  campaignId    String
  campaign      Campaign   @relation("RulebookActivations", fields: [campaignId], references: [id], onDelete: Cascade)
  rulebookId    String
  rulebook      Rulebook   @relation(fields: [rulebookId], references: [id], onDelete: Cascade)
  contentType   ChunkType?
  sourceIds     String[]
  activatedById String
  activatedBy   User       @relation("RulebookActivationActivatedBy", fields: [activatedById], references: [id])
  activatedAt   DateTime   @default(now())

  @@unique([campaignId, rulebookId, contentType])
  @@index([campaignId])
}

model ExtractedContent {
  id          String      @id @default(uuid())
  contentType ChunkType
  sourceId    String
  name        String
  data        Json
  rawText     String      @db.Text
  pageRef     String
  license     LicenseType @default(COPYRIGHT_WOTC)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([contentType, sourceId, name])
  @@index([contentType])
  @@index([sourceId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Who a drawing on a map is sent to: everyone who may read the map, or the
// DM alone.
enum DrawingAudience {
  ALL
  DM
}

// Where a drawing sits on a map: MARKUP over the grid, GROUND under it for
// DM-drawn map art. Only MARKUP is accepted so far (validators/drawings.ts).
enum DrawingLayer {
  MARKUP
  GROUND
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  displayName  String
  platformRole PlatformRole @default(USER)

  // Permissions
  globalAssetManager Boolean @default(false)
  // Can edit and delete anyone's character template, not just their own.
  // Defaults off — an admin grants it, the same way globalAssetManager works.
  templateEditor     Boolean @default(false)

  // MFA
  mfaEnabled     Boolean  @default(false)
  mfaSecret      String?
  mfaBackupCodes String[] // Array of hashed backup codes

  // Password Reset
  mustChangePassword Boolean @default(false)

  // Admin approval (when SystemSettings.requireAdminApproval is true)
  isApproved Boolean @default(true)

  // Profile
  avatarUrl String?
  bio       String? @db.Text

  // Preferences
  rememberMe  Boolean @default(false)
  preferences Json? // UserPreferences shape — see backend/src/validators/userPreferences.ts

  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  ownedCampaigns             Campaign[]            @relation("CampaignOwner")
  campaignMemberships        CampaignMembership[]
  campaignInvitations        CampaignInvitation[]
  characters                 Character[]
  messages                   Message[]
  diceRolls                  DiceRoll[]
  uploadedAssets             Asset[]
  passwordResetTokens        PasswordResetToken[]
  creatureFavorites          CreatureFavorite[]
  tokenTemplates             TokenTemplate[]
  characterTemplates         CharacterTemplate[]   @relation("CharacterTemplateAuthor")
  creatureTemplates          CreatureTemplate[]    @relation("CreatureTemplateAuthor")
  personalNotes              PersonalNote[]
  diceMacros                 DiceMacro[]
  mapExplorations            MapExploration[]
  documentLinks              CampaignDocument[]
  characterDrafts            CharacterDraft[]      @relation("CharacterDraftLastEditedBy")
  characterChanges           CharacterChange[]     @relation("CharacterChangeAuthor")
  characterChangeResolutions CharacterChange[]     @relation("CharacterChangeResolvedBy")
  characterLocks             CharacterLock[]       @relation("CharacterLockLockedBy")
  characterConflicts         CharacterConflict[]   @relation("CharacterConflictResolvedBy")
  uploadedRulebooks          Rulebook[]            @relation("RulebookUploadedBy")
  activatedRulebooks         RulebookActivation[]  @relation("RulebookActivationActivatedBy")
  createdMapTiles            MapTile[]             @relation("MapTileCreatedBy")
  resolvedActions            ActionResolution[]    @relation("ActionResolutionResolvedBy")
  lootDistributions          LootDistribution[]    @relation("LootDistributionCreator")
  completedLootDistributions LootDistribution[]    @relation("LootDistributionCompleter")
  lootAssignments            LootAssignment[]      @relation("LootAssignmentAuthor")
  confirmedLootAssignments   LootAssignment[]      @relation("LootAssignmentConfirmer")
  currencyTransactions       CurrencyTransaction[] @relation("CurrencyTransactionAuthor")
  createdShops               Shop[]                @relation("ShopCreatedBy")
  shopVisits                 ShopVisit[]
  shopTransactions           ShopTransaction[]
  createdSpellTemplates      SpellTemplate[]       @relation("SpellTemplateCreatedBy")
  issuedOverrides            DMOverride[]          @relation("DMOverrideIssuedBy")
  revertedOverrides          DMOverride[]          @relation("DMOverrideRevertedBy")
  receivedMessages    Message[]              @relation("MessageRecipient")
  drawings            MapDrawing[]

  @@index([email])
}

// ============================================
// SIGN-IN SESSIONS
// ============================================

// The sign-in store, connect-pg-simple (src/config/session.ts), keeps its
// rows here and reads and writes them itself, as does
// services/sessionStore.ts with raw queries. The model is here so the
// migrations make the table and `prisma db push` keeps it; @@ignore leaves it
// out of the Prisma client. Its columns, key and index are connect-pg-simple's
// own table.sql.
model LoginSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
  @@ignore
}

// ============================================
// PASSWORD RESET TOKENS
// ============================================

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ============================================
// CAMPAIGN MANAGEMENT
// ============================================

model Campaign {
  id          String         @id @default(uuid())
  name        String
  description String?        @db.Text
  status      CampaignStatus @default(PREPARATION)

  // Game System
  gameSystem GameSystem?

  // Ownership
  ownerId String
  owner   User   @relation("CampaignOwner", fields: [ownerId], references: [id])

  // Current Map
  currentMapId String?
  currentMap   Map?    @relation("CurrentMap", fields: [currentMapId], references: [id])

  // Vibe Tracker Settings
  vibeSettings Json // {periods: ["dawn", "day", "dusk", "night"], hues: {...}}
  currentVibe  String? // Current time period

  // Spirit Layer Settings
  spiritLayerEnabled Boolean @default(false)
  spiritLayerStyle   String  @default("wispy") // "wispy", "ethereal", "shadow", "custom"

  // Chat Settings
  chatCooldownEnabled Boolean @default(false)
  chatCooldownSeconds Int     @default(5)

  // Fog of War Settings
  /**
   * /**
   * /**
   * /** When true, players share their explored areas with the party (union of all explored cells).
   */
  fogShareExploredWithParty    Boolean  @default(false)
  /**
   * Characters excluded from party vision merge (e.g., familiars, scouts).
   */
  fogShareExcludedCharacterIds String[] @default([])
  // Drawing Settings
  // Players may draw on the map while the session is live; the DM always may.
  playersMayDraw Boolean @default(true)

  // Dice Settings
  diceMode             DiceMode  @default(TRUE_RANDOM)
  // When the DM clears roll history, this records when — rolls older than it
  // are hidden from the panel. A watermark rather than a delete, because every
  // roll including secret ones is kept deliberately for audit (see the
  // DiceRoll.secret column), and an accidental clear should not destroy that.
  // Null means never cleared.
  rollHistoryClearedAt DateTime?

  // Metadata
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastPlayedAt DateTime?

  // Relations
  memberships         CampaignMembership[]
  invitations         CampaignInvitation[]
  maps                Map[]                @relation("CampaignMaps")
  characters          Character[]
  messages            Message[]
  diceRolls           DiceRoll[]
  assets              Asset[]
  sessions            Session[]
  creatureTemplates   CreatureTemplate[]
  creatureFavorites   CreatureFavorite[]
  tokenTemplates      TokenTemplate[]
  personalNotes       PersonalNote[]
  diceMacros          DiceMacro[]
  documentLinks       CampaignDocument[]
  mapTiles            MapTile[]            @relation("MapTiles")
  rulebooks           Rulebook[]           @relation("Rulebooks")
  rulebookActivations RulebookActivation[] @relation("RulebookActivations")
  actionResolutions   ActionResolution[]   @relation("ActionResolutions")
  lootDistributions   LootDistribution[]   @relation("CampaignLootDistributions")
  shops               Shop[]
  spellTemplates      SpellTemplate[]      @relation("CampaignSpellTemplates")
  dmOverrides         DMOverride[]         @relation("CampaignDMOverrides")
  diceDecks           DiceDeck[]           @relation("CampaignDiceDecks")

  @@index([ownerId])
  @@index([status])
}

model CampaignMembership {
  id String @id @default(uuid())

  // Relationships
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Role
  role CampaignRole

  // Character Assignment
  characterIds String[] // Array of character IDs this user controls

  // Metadata
  joinedAt DateTime @default(now())

  @@unique([userId, campaignId])
  @@index([campaignId])
  @@index([userId])
}

model CampaignInvitation {
  id         String           @id @default(uuid())
  campaignId String
  campaign   Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  expiresAt  DateTime?

  @@unique([userId, campaignId])
  @@index([userId, status])
}

// ============================================
// SESSION MANAGEMENT
// ============================================

/// Notes a player or DM keeps for themselves, written in Markdown.
///
/// Private to whoever wrote them — including from the DM. Not to be confused
/// with `Session.notes`, which is a shared recap the whole campaign reads, or
/// with `TokenTemplate.notes`. Secret dice rolls are visible to the DM because
/// disputes need settling; nothing here needs that, so "personal" means it, and
/// every route scopes its query by the session's own user id.
///
/// `content` is Markdown source exactly as typed. Postgres TEXT has no
/// practical ceiling; the limit that matters is in the validator, so the column
/// never has to change if that limit is revisited. The list endpoint
/// deliberately does not select it — a panel that shipped every body would
/// transfer megabytes each time it opened.
model PersonalNote {
  id String @id @default(uuid())

  /// Cascade: a personal note has no meaning without its author.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Notes belong to the campaign they were written in, and go with it.
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  title   String
  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The only query shape there is: this user's notes in this campaign, most
  /// recently edited first.
  @@index([userId, campaignId, updatedAt])
}

model DiceMacro {
  id String @id @default(uuid())

  /// Cascade: a saved roll has no meaning without the player who saved it.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Macros belong to the table they were made for. A homebrew subsystem from
  /// one campaign has no business cluttering an unrelated game.
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// What the button says.
  name String

  /// A dice expression. Validated against the real parser on save, so a stored
  /// macro is one that can actually be rolled — see validators/diceMacros.ts.
  expression String

  /// Who the roll is made as when the dice panel's Character box is empty.
  /// Free text, as the box is: it names no Character row. Null for none.
  characterName String?

  /// What the roll is for, shown with it in place of the name. Null for the
  /// name itself.
  purpose String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Listed oldest first, so a macro keeps its place in the row. These are
  /// buttons people build muscle memory for; ordering by `updatedAt` the way
  /// notes do would move one to the front every time it was edited.
  @@index([userId, campaignId, createdAt])
}

model CampaignDocument {
  id String @id @default(uuid())

  /// The campaign the document is shared with. Deleting the campaign removes
  /// the link and leaves the document itself alone.
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// The document. Deleting the asset removes every link to it.
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Who shared it, for the audit trail. Before a user is deleted, their
  /// shares pass to the campaign's DM or owner (services/accountDeletion.ts),
  /// so the cascade removes none.
  linkedById String
  linkedBy   User   @relation(fields: [linkedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// A document is shared with a campaign once or not at all.
  @@unique([campaignId, assetId])
  @@index([campaignId])
  @@index([assetId])
}

model Session {
  id            String   @id @default(uuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessionNumber Int // Auto-incrementing per campaign

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Saved State
  savedState Json? // Token positions, map state, etc.

  notes String? @db.Text

  @@index([campaignId])
}

// ============================================
// CHARACTER MANAGEMENT
// ============================================

model Character {
  id String @id @default(uuid())

  // Ownership
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Campaign Assignment
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Game System
  gameSystem GameSystem?

  // Character Data
  name          String
  tokenImageUrl String?

  // Flexible Schema (JSON)
  data Json // {notes, stats, inventory, etc.}

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  draft                CharacterDraft?       @relation("CharacterDraft")
  changes              CharacterChange[]     @relation("CharacterChanges")
  locks                CharacterLock[]       @relation("CharacterLocks")
  conflicts            CharacterConflict[]   @relation("CharacterConflicts")
  actions              CharacterAction[]     @relation("CharacterActions")
  containers           InventoryContainer[]  @relation("CharacterContainers")
  currencyContainers   CurrencyContainer[]   @relation("CharacterCurrencyContainers")
  currencyTransactions CurrencyTransaction[] @relation("CharacterCurrencyTransactions")
  lootAssignments      LootAssignment[]      @relation("CharacterLootAssignments")
  attunementSlots      AttunementSlot[]      @relation("CharacterAttunementSlots")

  @@index([userId])
  @@index([campaignId])
  @@index([gameSystem])
}

/// A shareable starter sheet that anyone on the instance can browse and copy
/// into a character of their own.
///
/// Unlike CreatureTemplate and TokenTemplate, this has no campaignId and no
/// scope column: every template is visible to every authenticated user, which
/// is the whole point of the feature. Who may *edit* one is decided at the
/// route (author, admin, or a user with User.templateEditor).
///
/// Not to be confused with the hardcoded starter presets in
/// backend/src/utils/character-templates/ — those are source constants served
/// by GET /api/characters/templates/:system/:name, not rows.
model CharacterTemplate {
  id String @id @default(uuid())

  name        String
  description String? @db.Text

  // null = flexible / system-agnostic, matching Character.gameSystem
  gameSystem GameSystem?

  /// Must reference a GLOBAL-scoped asset. A template is visible to everyone,
  /// so a USER-scoped image would 403 for every reader but its owner.
  tokenImageUrl String?

  /// The sheet itself — same shape as Character.data for the same gameSystem.
  data Json

  /// Nullable with SetNull: deleting the author must not destroy a template
  /// other people are still copying from.
  createdById String?
  createdBy   User?   @relation("CharacterTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameSystem])
  @@index([createdById])
  @@index([name])
}

// ============================================
// MAP & TOKEN MANAGEMENT
// ============================================

model Map {
  id String @id @default(uuid())

  // Ownership
  campaignId String
  campaign   Campaign @relation("CampaignMaps", fields: [campaignId], references: [id], onDelete: Cascade)

  // Map Data
  name          String
  imageUrl      String
  width         Int // In grid units
  height        Int // In grid units
  gridSize      Int    @default(50) // Pixels per grid square
  feetPerSquare Int    @default(5) // Feet represented by one grid square
  diagonalRule  String @default("flat") // "flat" (D&D 5e) or "alternating" (PF2e 5/10)
  // The colour a map drawn in CozyVTT was made in, as #rrggbb: what
  // Mapmaker's eraser paints. Null for a map made from a picture, and for one
  // drawn before this was kept.
  drawnBackground String?

  // Layers
  baseLayerUrl   String // Main map image
  spiritLayerUrl String? // Optional spirit realm overlay

  // State
  tokens      Json // Array of token objects with positions
  annotations Json // Array of annotations (drawings, markers)

  // Walls & Fog of War
  wallSegments       Json    @default("[]") // Array of WallSegment objects
  fogData            Json? // FogState object (null = not initialized)
  lightingEnabled    Boolean @default(false) // Enable dynamic lighting/raycasting
  fogEnabled         Boolean @default(true) // Manual fog of war on this map; off = players see the whole map
  globalIllumination Boolean @default(true) // Everything in line of sight is lit; off = lights and darkvision decide
  explorationEnabled Boolean @default(true) // Players' explored areas are remembered (greyed in) on this map
  lights             Json    @default("[]") // Array of LightSource objects

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  activeCampaigns Campaign[]       @relation("CurrentMap")
  explorations    MapExploration[]
  layers          MapLayer[]
  shops           Shop[]           @relation("MapShops")
  drawings        MapDrawing[]

  @@index([campaignId])
}

/// One drawing on one map: a stroke, a shape or a text label, with who drew
/// it and who is sent it. Points are in whole map pixels from the map's
/// top-left corner, as walls and lights are. `Map.annotations` predates this
/// table and holds nothing the app reads.
model MapDrawing {
  id        String          @id @default(uuid())
  mapId     String
  map       Map             @relation(fields: [mapId], references: [id], onDelete: Cascade)
  /// Null once the author's account is deleted; the drawing stays, the DM's to erase.
  authorId  String?
  author    User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  audience  DrawingAudience @default(ALL)
  layer     DrawingLayer    @default(MARKUP)
  /// pen, line, arrow, rect, ellipse, polygon or text (validators/drawingLimits.ts)
  kind      String
  /// The stroke, #rrggbb
  color     String
  /// The fill, #rrggbb; null for none
  fillColor String?
  /// A texture name; null for a flat fill. Not accepted yet
  pattern   String?
  /// A glyph name, for a stamp. Not accepted yet
  stamp     String?
  /// Map pixels, 1 to 64
  width     Int
  /// Degrees, 0 to 359
  rotation  Int             @default(0)
  /// Drawing order within a layer, then createdAt
  sortKey   Int             @default(0)
  /// [[x, y], ...] in whole map pixels, top-left origin
  points    Json
  /// A text label's words; null for every other kind
  text      String?
  createdAt DateTime        @default(now())

  @@index([mapId])
}

/// What one player has explored on one map: the cells their vision has
/// covered, kept in the FogState shape so the fog helpers apply unchanged.
/// Never read when deciding which tokens to send; it only greys in map
/// artwork the client already holds.
model MapExploration {
  id     String @id @default(uuid())
  mapId  String
  map    Map    @relation(fields: [mapId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  explored  Json // FogState: { fogCols, fogRows, cellPx, revealed: boolean[] }
  updatedAt DateTime @updatedAt

  @@unique([mapId, userId])
  @@index([mapId])
}

// ============================================
// ASSET LIBRARY
// ============================================

model Asset {
  id String @id @default(uuid())

  // Classification
  type  AssetType
  scope AssetScope

  // Ownership
  // Null once the uploader's account is deleted: the file stays, owned by
  // no one, for the maps and tokens that use it.
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  campaignId   String? // Null for global assets
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // File Data
  filename     String
  originalName String
  mimeType     String
  fileSize     Int // In bytes
  filePath     String // Relative path in storage

  // Metadata
  name        String
  description String?
  tags        String[]

  // Thumbnail
  thumbnailPath String?

  createdAt DateTime @default(now())

  /// Campaigns this document has been shared with. Only meaningful for
  /// DOCUMENT assets; the link is what grants a campaign's members the right
  /// to read a document that is otherwise private to its uploader.
  campaignLinks CampaignDocument[]
  mapTiles      MapTile[]          @relation("MapTileAsset")

  /// When a document's text was last read for the assets it names
  /// (DocumentPicture). Null on every other asset, and on a document stored
  /// before this was kept, until the server has read it
  /// (services/sharedDocumentPictures.ts).
  picturesReadAt   DateTime?
  /// The assets this document's text names by their address.
  picturesNamed    DocumentPicture[] @relation("DocumentNames")
  /// The documents whose text names this asset by its address.
  namedInDocuments DocumentPicture[] @relation("NamedInDocument")

  @@index([campaignId])
  @@index([type])
  @@index([scope])
  @@index([uploadedById])
  /// The documents not read yet, found without reading every document.
  @@index([type, picturesReadAt])
}

/// One asset a plain text or Markdown document names by its address
/// (`/api/assets/<kind>/<id>`), as read from the document's text when it is
/// uploaded, written or saved. What a shared handout shows players
/// (services/sharedDocumentPictures.ts), and what keeps a picture from a
/// delete that is not forced (services/assetUsage.ts), are read from here,
/// never from the files.
model DocumentPicture {
  /// The document. Deleting it removes what it names.
  documentId String
  document   Asset  @relation("DocumentNames", fields: [documentId], references: [id], onDelete: Cascade)

  /// The asset it names. Deleting that asset removes the row as well.
  pictureId String
  picture   Asset  @relation("NamedInDocument", fields: [pictureId], references: [id], onDelete: Cascade)

  /// A document names an asset once or not at all.
  @@id([documentId, pictureId])
  @@index([pictureId])
}

// ============================================
// COMMUNICATION
// ============================================

model Message {
  id String @id @default(uuid())

  // Context
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  userId String? // Null for system messages
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // The one member a WHISPER is for. The type marks a message private, and
  // this says who it is for: deleting the recipient's account empties it,
  // and the whisper stays its sender's alone.
  recipientId String?
  recipient   User?   @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  // Content
  type     MessageType
  content  String      @db.Text
  metadata Json? // For system messages, dice rolls, etc.

  // Metadata
  createdAt DateTime @default(now())

  @@index([campaignId, createdAt])
  @@index([campaignId, recipientId, createdAt])
}

model DiceRoll {
  id String @id @default(uuid())

  // Context
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Null once the roller's account is deleted: the roll stays in the
  // campaign's history, as a deleted user's chat messages do.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Roll Data
  expression String // e.g., "2d6+3"
  result     Int
  breakdown  Json // Detailed roll breakdown

  // Character Context
  characterName String?
  purpose       String? // e.g., "Attack roll", "Perception check"

  // Mode & Metadata (Phase 12)
  mode           DiceMode      @default(TRUE_RANDOM)
  isReroll       Boolean       @default(false)
  originalRollId String?
  originalRoll   DiceRoll?     @relation("RerollChain", fields: [originalRollId], references: [id], onDelete: SetNull)
  rerolls        DiceRoll[]    @relation("RerollChain")
  rerollReason   RerollReason?
  rerollNumber   Int           @default(0)
  deckPosition   Int?
  deckSize       Int?
  deckSeed       String?

  // Visibility
  secret    Boolean  @default(false) // Secret rolls visible only to roller and DM
  visibleTo String[] @default([])

  // Metadata
  rolledAt DateTime @default(now())

  @@index([campaignId, rolledAt])
  @@index([originalRollId])
}

// ============================================
// CREATURE LIBRARY
// ============================================

model CreatureTemplate {
  id String @id @default(uuid())

  // Classification
  name            String
  gameSystem      GameSystem?
  source          String      @default("custom") // "srd", "custom", or a homebrew source name
  challengeRating String? // e.g. "1/4", "5", "20"

  // Creature info
  creatureType String? // e.g. "Medium humanoid (goblinoid)"
  alignment    String? // e.g. "neutral evil"
  imageUrl     String? // Optional token image

  // Full stat block (JSON — matches NpcStatBlock interface)
  statBlock Json

  // Token placement defaults
  size        Json   @default("{\"width\":1,\"height\":1}") // Size object
  disposition String @default("hostile") // friendly/neutral/hostile
  displayMode String @default("pog") // pog/top-down/full-art

  // Who made it: null for the seeded SRD creatures, and for any whose
  // author's account has been deleted, which keeps the creature. `source`
  // says whether it is SRD or homebrew.
  createdById String?
  createdBy   User?     @relation("CreatureTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  campaignId  String? // null = available globally, set = campaign-specific
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites CreatureFavorite[]

  @@index([gameSystem])
  @@index([source])
  @@index([campaignId])
  @@index([name])
  @@index([createdById])
}

// ============================================
// CREATURE FAVORITES (per-campaign, per-user)
// ============================================

model CreatureFavorite {
  id         String   @id @default(uuid())
  campaignId String
  userId     String
  creatureId String
  createdAt  DateTime @default(now())

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  creature CreatureTemplate @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId, creatureId])
  @@index([campaignId, userId])
}

// ============================================
// TOKEN TEMPLATES (reusable token configurations)
// ============================================

model TokenTemplate {
  id          String  @id @default(uuid())
  name        String
  imageUrl    String?
  type        String  @default("object") // 'player' | 'npc' | 'object'
  disposition String? // 'friendly' | 'neutral' | 'hostile' | null
  displayMode String  @default("pog") // 'pog' | 'top-down' | 'full-art'
  size        Json    @default("{\"width\":1,\"height\":1}")
  notes       String? @db.Text
  hp          Json? // { current, max, temp } or null
  showHpBar   Boolean @default(false)
  statBlock   Json? // NpcStatBlock or null
  sightRadius Float? // For dynamic lighting (grid squares)

  // Ownership
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([name])
}

model CharacterAction {
  id          String       @id @default(uuid())
  characterId String
  character   Character    @relation("CharacterActions", fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  type        ActionType
  cost        ActionCost
  data        Json // Action-specific: attack bonus, damage, save DC, area, etc.
  source      ActionSource
  sourceRef   String? // e.g., "feat:great-weapon-master", "spell:fireball"
  recharge    Json? // {type: "SHORT_REST" | "LONG_REST" | "TURN_START" | "CUSTOM", value: ...}
  used        Boolean      @default(false)
  sortOrder   Int          @default(0)

  @@index([characterId])
}

model ActionResolution {
  id           String           @id @default(uuid())
  campaignId   String
  campaign     Campaign         @relation("ActionResolutions", fields: [campaignId], references: [id], onDelete: Cascade)
  initiatorId  String // Character or Token ID
  targetIds    String[] // Token IDs
  actionId     String? // CharacterAction ID if from sheet
  actionType   ActionType
  actionData   Json // Snapshot of action at resolution time
  attackRolls  Json? // [{expression, result, breakdown, vsAC}]
  saveRolls    Json? // [{targetId, expression, result, breakdown, vsDC, success}]
  damageRolls  Json? // [{targetId, expression, result, breakdown, type, applied}]
  conditions   Json? // Applied conditions per target
  resources    Json? // Consumed: spell slots, charges, uses
  status       ResolutionStatus
  dmOverride   Boolean          @default(false)
  dmNotes      String?          @db.Text
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?            @relation("ActionResolutionResolvedBy", fields: [resolvedById], references: [id])

  @@index([campaignId, createdAt])
  @@index([initiatorId])
}

// ============================================
// INVENTORY & CURRENCY MANAGEMENT (Phase 5)
// ============================================

enum ContainerType {
  BACKPACK
  POUCH
  CHEST
  CART
  BAG_OF_HOLDING
  PORTABLE_HOLE
  HANDY_HAVERSACK
  QUIVER
  SCABBARD
  SHEATH
  BELT_POUCH
  SATCHel
  CUSTOM
}

enum CurrencyType {
  CP
  SP
  EP
  GP
  PP
  NUYEN
  CASH
}

model InventoryContainer {
  id                      String               @id @default(uuid())
  characterId             String
  character               Character            @relation("CharacterContainers", fields: [characterId], references: [id], onDelete: Cascade)
  name                    String
  type                    ContainerType        @default(CUSTOM)
  // Parent container (for nesting)
  parentId                String?
  parent                  InventoryContainer?  @relation("ContainerNesting", fields: [parentId], references: [id], onDelete: SetNull)
  children                InventoryContainer[] @relation("ContainerNesting")
  // Currency containers in this inventory container
  currencyContainers      CurrencyContainer[]  @relation("CurrencyInContainer")
  // Capacity
  capacity                Float // Weight capacity (lbs, bulk, or kg)
  capacityUnit            String               @default("LBS") // LBS, BULK, KG
  // Base weight of empty container
  baseWeight              Float                @default(0)
  // Special container properties
  isMagical               Boolean              @default(false)
  magicType               String? // "bag_of_holding", "portable_hole", "handy_haversack"
  // For Bag of Holding: which extradimensional space
  extradimensionalSpaceId String?
  // Description/notes
  notes                   String?              @db.Text
  // Sort order
  sortOrder               Int                  @default(0)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([characterId])
  @@index([parentId])
}

model CurrencyContainer {
  id               String                @id @default(uuid())
  characterId      String
  character        Character             @relation("CharacterCurrencyContainers", fields: [characterId], references: [id], onDelete: Cascade)
  containerId      String? // Link to InventoryContainer if currency is in a physical container
  container        InventoryContainer?   @relation("CurrencyInContainer", fields: [containerId], references: [id], onDelete: SetNull)
  name             String // "Belt Pouch", "Backpack", "Main Purse"
  // D&D 5e / Pathfinder currencies
  cp               Int                   @default(0)
  sp               Int                   @default(0)
  ep               Int                   @default(0)
  gp               Int                   @default(0)
  pp               Int                   @default(0)
  // Shadowrun
  nuyen            Int                   @default(0)
  // Call of Cthulhu
  cash             Float                 @default(0)
  // Custom currency (JSON for extensibility)
  custom           Json?
  isDefault        Boolean               @default(false) // Main currency pool
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  // Transactions from this container
  fromTransactions CurrencyTransaction[] @relation("TransactionFromContainer")
  // Transactions to this container
  toTransactions   CurrencyTransaction[] @relation("TransactionToContainer")

  @@index([characterId])
  @@index([containerId])
}

model CurrencyTransaction {
  id              String             @id @default(uuid())
  characterId     String
  character       Character          @relation("CharacterCurrencyTransactions", fields: [characterId], references: [id], onDelete: Cascade)
  fromContainerId String?
  fromContainer   CurrencyContainer? @relation("TransactionFromContainer", fields: [fromContainerId], references: [id], onDelete: SetNull)
  toContainerId   String?
  toContainer     CurrencyContainer? @relation("TransactionToContainer", fields: [toContainerId], references: [id], onDelete: SetNull)
  type            TransactionType // ADD, REMOVE, TRANSFER, CONVERT, SPLIT, MERGE, PAY, RECEIVE
  // Amounts (positive values)
  cp              Int                @default(0)
  sp              Int                @default(0)
  ep              Int                @default(0)
  gp              Int                @default(0)
  pp              Int                @default(0)
  nuyen           Int                @default(0)
  cash            Float              @default(0)
  custom          Json?
  // Reason/description
  description     String             @db.Text
  // Reference to source (shop, loot, trade, etc.)
  sourceType      String? // "SHOP", "LOOT", "TRADE", "MANUAL", "CONVERSION"
  sourceId        String?
  createdById     String
  createdBy       User               @relation("CurrencyTransactionAuthor", fields: [createdById], references: [id])
  createdAt       DateTime           @default(now())

  @@index([characterId, createdAt])
  @@index([fromContainerId])
  @@index([toContainerId])
}

enum TransactionType {
  ADD
  REMOVE
  TRANSFER
  CONVERT
  SPLIT
  MERGE
  PAY
  RECEIVE
}

model LootDistribution {
  id            String           @id @default(uuid())
  campaignId    String
  campaign      Campaign         @relation("CampaignLootDistributions", fields: [campaignId], references: [id], onDelete: Cascade)
  name          String // "Goblin Cave Loot", "Dragon Hoard"
  sourceType    String // "CREATURE", "MANUAL", "TABLE", "SHOP"
  sourceId      String? // CreatureTemplate ID, Shop ID, etc.
  status        LootStatus       @default(PENDING)
  items         Json // Array of loot items with value, weight, attunement
  currency      Json // Total currency {cp, sp, ep, gp, pp, nuyen, cash}
  createdById   String
  createdBy     User             @relation("LootDistributionCreator", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  completedAt   DateTime?
  completedById String?
  completedBy   User?            @relation("LootDistributionCompleter", fields: [completedById], references: [id])
  // Assignments
  assignments   LootAssignment[]

  @@index([campaignId, status])
}

enum LootStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model LootAssignment {
  id               String           @id @default(uuid())
  distributionId   String
  distribution     LootDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  characterId      String
  character        Character        @relation("CharacterLootAssignments", fields: [characterId], references: [id], onDelete: Cascade)
  assignedItems    Json // Items assigned to this character
  assignedCurrency Json // Currency assigned to this character
  assignedById     String
  assignedBy       User             @relation("LootAssignmentAuthor", fields: [assignedById], references: [id])
  confirmedAt      DateTime?
  confirmedById    String?
  confirmedBy      User?            @relation("LootAssignmentConfirmer", fields: [confirmedById], references: [id])
  createdAt        DateTime         @default(now())

  @@index([distributionId])
  @@index([characterId])
}

model AttunementSlot {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation("CharacterAttunementSlots", fields: [characterId], references: [id], onDelete: Cascade)
  itemId      String // Inventory item ID (from Character.data.inventory)
  itemName    String
  attunedAt   DateTime  @default(now())
  notes       String?   @db.Text
  // For tracking slot usage (max 3 for D&D 5e)
  slotNumber  Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, slotNumber])
  @@index([characterId])
}

// ============================================

model SystemLog {
  id String @id @default(uuid())

  level   LogLevel
  message String   @db.Text
  context Json? // Additional context data

  userId     String?
  campaignId String?

  createdAt DateTime @default(now())

  @@index([level, createdAt])
}

// ============================================
// SYSTEM SETTINGS
// ============================================

model SystemSettings {
  id String @id @default(uuid())

  // Setup Wizard State
  setupCompleted Boolean @default(false)

  // Instance Configuration
  instanceName String @default("CozyVTT")
  timezone     String @default("UTC")

  // User Registration Settings
  allowRegistration    Boolean @default(false)
  requireAdminApproval Boolean @default(true)

  // Appearance
  themeId           String  @default("cozy-default")
  customThemeColors Json?
  fontId            String  @default("default")
  customLogoUrl     String?
  customFaviconUrl  String?
  customMascotUrl   String?

  // Campaign Export/Import
  campaignExportSizeLimit Int @default(524288000) // 500 MB in bytes

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// SHOP SYSTEM (Phase 7)
// ============================================

enum ShopType {
  GENERAL
  MAGIC
  BLACKSMITH
  ALCHEMIST
  TEMPLE
  BLACK_MARKET
  CUSTOM
}

enum ShopItemType {
  RULEBOOK_SPELL
  RULEBOOK_ITEM
  RULEBOOK_MONSTER_PART
  CUSTOM_ITEM
  CHARACTER_TEMPLATE
  TOKEN_TEMPLATE
  LOOT_TABLE
}

enum ShopTransactionType {
  BUY
  SELL
}

model Shop {
  id           String   @id @default(uuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name         String
  description  String?  @db.Text
  type         ShopType
  // Location
  mapId        String?
  map          Map?     @relation("MapShops", fields: [mapId], references: [id], onDelete: SetNull)
  tokenId      String? // If shop is an NPC token on map
  // Pricing
  buyModifier  Float    @default(1.0) // Player buys at base × this
  sellModifier Float    @default(0.5) // Player sells at base × this
  currency     Json // Accepted currencies + exchange rates
  // Stock
  restockRule  Json? // {interval: "DAWN" | "WEEKLY" | "MONTHLY", chance: 0.5, maxRestock: 3}
  isActive     Boolean  @default(true)
  createdById  String
  createdBy    User     @relation("ShopCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items        ShopItem[]
  visits       ShopVisit[]
  transactions ShopTransaction[]

  @@index([campaignId])
  @@index([mapId])
  @@index([tokenId])
}

model ShopItem {
  id            String       @id @default(uuid())
  shopId        String
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Item reference
  itemType      ShopItemType // RULEBOOK, CUSTOM, TEMPLATE, LOOT
  itemRef       String // ID from rulebook, custom item, or template
  itemName      String // Denormalized for display
  itemData      Json // Full item data snapshot
  // Stock
  stock         Int          @default(1) // -1 = unlimited
  maxStock      Int          @default(-1)
  currentStock  Int          @default(1)
  // Pricing override
  priceOverride Json? // {cp?, sp?, ep?, gp?, pp?} - overrides base price
  // Display
  category      String? // "Weapons", "Potions", "Scrolls"
  sortOrder     Int          @default(0)
  isVisible     Boolean      @default(true)
  notes         String?      @db.Text // DM-only notes

  @@index([shopId, category])
  @@index([shopId, isVisible])
}

model ShopVisit {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitedAt DateTime @default(now())
  purchases Json // [{itemId, qty, pricePaid}]
  sales     Json // [{itemId, qty, priceReceived}]

  @@index([shopId, userId])
  @@index([userId, visitedAt])
}

model ShopTransaction {
  id        String              @id @default(uuid())
  shopId    String
  shop      Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ShopTransactionType // BUY, SELL
  items     Json // [{itemId, itemName, qty, unitPrice, totalPrice}]
  currency  Json // {cp, sp, ep, gp, pp} paid/received
  createdAt DateTime            @default(now())

  @@index([shopId, createdAt])
  @@index([userId, createdAt])
}

model SpellTemplate {
  id          String    @id @default(uuid())
  campaignId  String?
  campaign    Campaign? @relation("CampaignSpellTemplates", fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  shape       AoEShape
  size        Json // {radius?, length?, width?, height?, side?}
  origin      String    @default("intersection") // "intersection" | "token_center" | "self"
  gridSnap    Boolean   @default(true)
  color       String    @default("#3b82f6")
  isDefault   Boolean   @default(false)
  createdById String?
  createdBy   User?     @relation("SpellTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([campaignId])
}

enum AoEShape {
  CIRCLE
  CONE
  LINE
  CUBE
  SPHERE
  CYLINDER
  HEMISPHERE
  CUSTOM
}

model DMOverride {
  id             String             @id @default(uuid())
  campaignId     String
  campaign       Campaign           @relation("CampaignDMOverrides", fields: [campaignId], references: [id], onDelete: Cascade)
  targetType     OverrideTargetType
  targetId       String
  fieldPath      String
  previousValue  Json
  newValue       Json
  reason         String             @db.Text
  visibility     OverrideVisibility
  overriddenById String
  overriddenBy   User               @relation("DMOverrideIssuedBy", fields: [overriddenById], references: [id])
  overriddenAt   DateTime           @default(now())
  revertedAt     DateTime?
  revertedById   String?
  revertedBy     User?              @relation("DMOverrideRevertedBy", fields: [revertedById], references: [id])
  revertReason   String?            @db.Text

  @@index([campaignId, overriddenAt])
  @@index([targetType, targetId])
}

enum OverrideTargetType {
  ROLL
  ROLL_BREAKDOWN
  HP
  DAMAGE
  TEMP_HP
  DEATH_SAVES
  CONDITIONS
  POSITION
  MOVEMENT
  REACHABLE_AREA
  INITIATIVE
  TURN_ORDER
  REACTION
  ACTION_RESOLUTION
  SPELL_SLOTS
  CHARGES
  HIT_DICE
  SUPERIORITY_DICE
  KI_POINTS
  CHANNEL_DIVINITY
  FOG
  LIGHT
  WALLS
  DOORS
  TERRAIN
  NARRATIVE
  CHAT
}

enum OverrideVisibility {
  DM_ONLY
  DM_AND_PLAYERS
  TABLE
}

model DiceDeck {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation("CampaignDiceDecks", fields: [campaignId], references: [id], onDelete: Cascade)
  expression String // Normalized: "2d6", "1d20", "4d6kh3"
  deck       Json // DeckOutcome[]
  position   Int      @default(0)
  seed       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, expression])
  @@index([campaignId])
}

enum DiceMode {
  TRUE_RANDOM
  WEIGHTED_DECK
}

enum RerollReason {
  ADVANTAGE
  DISADVANTAGE
  HALFLING_LUCK
  ELVEN_ACCURACY
  GREAT_WEAPON_FIGHTING
  BLESS
  BANE
  PORTENT
  DM_FORCED
  PLAYER_CHOICE
  REROLL_FEATURE
  OTHER
}
